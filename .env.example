# ASI Chain Explorer environment
# Every REACT_APP_* value is public: every visitor can read it. Do not put a
# secret in a REACT_APP_* variable. The explorer sends no Hasura credential.
#
# The endpoint variables below (GraphQL, indexer API, node URL) are read at
# container start by the Docker image and written to /config.js. With npm start
# or npm run build, create-react-app reads them at build time.

# Hasura GraphQL endpoints of the indexer stack (required)
REACT_APP_GRAPHQL_URL=http://localhost:8080/v1/graphql
REACT_APP_GRAPHQL_WS_URL=ws://localhost:8080/v1/graphql

# Indexer status page. The browser calls REACT_APP_INDEXER_API_URL/status.
# Production nginx forwards GET /api/indexer/status to INDEXER_STATUS_URL
# (server-side, read by docker-entrypoint.sh, not embedded in the bundle).
REACT_APP_INDEXER_API_URL=/api/indexer
INDEXER_STATUS_URL=http://host.docker.internal:9090/status

# Fallback precision for wallet balances from nodes without nativeTokenDecimals.
# Indexed blocks, transfers and bonds carry their own token_decimals.
REACT_APP_NATIVE_TOKEN_DECIMALS=8

# Feedback form: the URL that receives the form POST.
REACT_APP_FEEDBACK_FORM_URL=
# AWS WAF CAPTCHA for the feedback form. Without both values, the form uses plain fetch.
REACT_APP_JSAPI_URL=
REACT_APP_CAPTCHA_TOKEN=

# Node HTTP API for the wallet balance lookup (src/services/walletService.ts).
# Empty means the explorer origin.
# The WalletSearch component is not mounted in the current UI.
REACT_APP_RCHAIN_NODE_URL=

# GraphQL schema check (scripts/validate-graphql.js), not used by the app
# HASURA_GRAPHQL_ENDPOINT=http://localhost:8080/v1/graphql
